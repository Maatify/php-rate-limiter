{
    "name": "consumer-verification/maatify-rate-limiter",
    "description": "External consumer fixture for maatify/php-rate-limiter.",
    "license": "proprietary",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "__PACKAGE_ROOT__",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "ConsumerVerification\\": "src/"
        }
    },
    "require": {
        "maatify/php-rate-limiter": "*"
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
