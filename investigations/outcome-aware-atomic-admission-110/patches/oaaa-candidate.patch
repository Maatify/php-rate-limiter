+    // ---- EXPERIMENTAL #110 OAAA (study only) -------------------------------------------------------------------------
+
+    private function noteOutcomeAdmissionScope(
+        string $rule,
+        BoundedCorrelationObservationDTO $observation,
+        bool $fired,
+        bool $advisory = false,
+    ): void {
+        $this->oaaaObserved[] = [
+            'rule' => $rule,
+            'key' => $observation->currentKey,
+            'previousKey' => $observation->previousKey,
+            'fired' => $fired,
+            'advisory' => $advisory,
+        ];
+    }
+
+    /**
+     * @param array<string, string|null> $keysV2
+     */
+    private function isOutcomeAwareAdmissionActive(
+        BlockPolicyInterface $policy,
+        RateLimitContextDTO $context,
+        array $keysV2,
+    ): bool {
+        return $this->correlationStore instanceof OutcomeAdmissionStoreInterface
+            && ! $this->isApiHeavyPolicy($policy)
+            && ($this->isCredentialSprayPolicy($policy)
+                || $this->hasCapability($policy, PolicyCapabilityEnum::TRUSTED_AUTHENTICATION))
+            && $context->accountId !== null
+            && ($keysV2['k4'] ?? null) !== null
+            && ($keysV2['k1'] ?? null) !== null
+            && ($keysV2['k2'] ?? null) !== null;
+    }
+
+    private function outcomeAdmissionStore(): OutcomeAdmissionStoreInterface
+    {
+        if (! $this->correlationStore instanceof OutcomeAdmissionStoreInterface) {
+            throw new RateLimiterException('Outcome-aware admission requires OutcomeAdmissionStoreInterface.');
+        }
+
+        return $this->correlationStore;
+    }
+
+    /**
+     * Pre-check: when an S0 correlation rule fires, reserve one unit on every
+     * fired scope (credit-gated), the scope day tier and the global tiers in one
+     * atomic operation; granted removes the correlation candidates, refused
+     * keeps them (S0). Outcome commands first resolve the tuple's reservations;
+     * a success never issues a correlation block, a paired failure is already
+     * paid, an unpaired failure must reserve-and-spend like a pre-check.
+     *
+     * @param array<string, string|null> $keysV2
+     * @param array<string, string|null> $keysV1
+     * @param list<array{cidr: int, currentScope: string, previousScope: ?string}> $adaptiveIpv6Scopes
+     * @param list<array{decision: string, level: int, retryAfter: int, source: string, persistence: list<array{key: string, previousKey: ?string, level: int, duration: int}>}> $candidates
+     * @return array{0: list<array{decision: string, level: int, retryAfter: int, source: string, persistence: list<array{key: string, previousKey: ?string, level: int, duration: int}>}>, 1: ?array{tuple: string, tiers: list<string>}}
+     */
+    private function applyOutcomeAwareAdmission(
+        BlockPolicyInterface $policy,
+        RateLimitContextDTO $context,
+        RateLimitCommand $request,
+        DeviceIdentityDTO $device,
+        array $keysV2,
+        array $keysV1,
+        array $adaptiveIpv6Scopes,
+        array $candidates,
+    ): array {
+        $store = $this->outcomeAdmissionStore();
+        $policyName = $policy->getName();
+        $scopes = $this->oaaaObserved;
+        if (! $request->isPreCheck && $this->isCredentialSprayPolicy($policy)) {
+            $subject = $context->correlationId ?? $context->accountId;
+            if ($subject !== null) {
+                $scopes[] = $this->outcomeAdmissionSprayScope(
+                    $this->buildCredentialSprayObservation($subject, (string) $keysV2['k1'], $keysV1['k1'] ?? null),
+                );
+                foreach ($adaptiveIpv6Scopes as $scope) {
+                    $scopes[] = $this->outcomeAdmissionSprayScope($this->buildAdaptiveCorrelationObservation(
+                        $policyName,
+                        'spray',
+                        $scope['cidr'],
+                        $scope['currentScope'],
+                        $subject,
+                        $scope['previousScope'],
+                        $subject,
+                    ));
+                }
+            }
+        }
+
+        $tuple = $this->hashKey(
+            "{$policyName}:rate_limiter:oaaa:tuple:v1:{$this->envScope}:{$keysV2['k4']}:{$device->fingerprintHash}:{$keysV2['k1']}:{$keysV2['k2']}",
+            $this->secret,
+        );
+        $allTierKeys = $this->outcomeAdmissionTierKeys($scopes, $policyName);
+
+        $paired = [];
+        if (! $request->isPreCheck) {
+            $paired = $store->completeAdmission(
+                $tuple,
+                $request->isSuccess ? 'success' : 'failure',
+                $allTierKeys,
+                $device->confidence === 'LOW' ? 0 : self::OAAA_REFUND_FAILURES,
+                $request->isSuccess ? $this->outcomeAdmissionCreditKeys($scopes) : [],
+                $this->hashKey("{$policyName}:rate_limiter:oaaa:credit:v1:{$this->envScope}:{$keysV2['k4']}", $this->secret),
+                self::OAAA_CREDIT_MEMBERS,
+                2 * self::OAAA_CREDIT_WINDOW_SECONDS,
+            );
+        }
+
+        $fired = [];
+        foreach ($scopes as $scope) {
+            if ($scope['fired'] && ! $scope['advisory']) {
+                $fired[$scope['rule'] . '|' . $scope['key']] = $scope;
+            }
+        }
+        $isCorrelation = static fn(array $candidate): bool => in_array($candidate['source'], ['correlation', 'credential_spray'], true);
+        $withoutCorrelation = array_values(array_filter($candidates, static fn(array $candidate): bool => ! $isCorrelation($candidate)));
+        if ($fired === [] || count($withoutCorrelation) === count($candidates)) {
+            return [$candidates, null];
+        }
+        $fired = array_values($fired);
+
+        if ($request->isSuccess) {
+            return [$withoutCorrelation, null];
+        }
+
+        if ($request->isFailure) {
+            $unpaired = array_values(array_filter(
+                $fired,
+                fn(array $scope): bool => ! in_array($this->outcomeAdmissionEpochTier($scope['rule'], $scope['key']), $paired, true),
+            ));
+            if ($unpaired === []) {
+                return [$withoutCorrelation, null];
+            }
+            if (! $store->reserveAdmission($tuple, self::OAAA_TUPLE_SECONDS, $this->outcomeAdmissionTiers($unpaired, $policyName))) {
+                return [$candidates, null];
+            }
+            $store->completeAdmission(
+                $tuple,
+                'failure',
+                $this->outcomeAdmissionTierKeys($unpaired, $policyName),
+                0,
+                [],
+                '',
+                self::OAAA_CREDIT_MEMBERS,
+                2 * self::OAAA_CREDIT_WINDOW_SECONDS,
+            );
+
+            return [$withoutCorrelation, null];
+        }
+
+        if (! $store->reserveAdmission($tuple, self::OAAA_TUPLE_SECONDS, $this->outcomeAdmissionTiers($fired, $policyName))) {
+            return [$candidates, null];
+        }
+
+        return [$withoutCorrelation, ['tuple' => $tuple, 'tiers' => $this->outcomeAdmissionTierKeys($fired, $policyName)]];
+    }
+
+    /**
+     * @return array{rule: string, key: string, previousKey: ?string, fired: bool, advisory: bool}
+     */
+    private function outcomeAdmissionSprayScope(BoundedCorrelationObservationDTO $observation): array
+    {
+        return ['rule' => 'spray', 'key' => $observation->currentKey, 'previousKey' => $observation->previousKey, 'fired' => false, 'advisory' => false];
+    }
+
+    private function outcomeAdmissionEpochTier(string $rule, string $scopeKey): string
+    {
+        return "oaaa:v1:e:{$rule}:{$scopeKey}";
+    }
+
+    private function outcomeAdmissionDayTier(string $rule, string $scopeKey): string
+    {
+        return "oaaa:v1:d:{$rule}:{$scopeKey}";
+    }
+
+    private function outcomeAdmissionCreditKey(string $rule, string $scopeKey, int $window): string
+    {
+        return "oaaa:v1:c:{$rule}:{$scopeKey}:{$window}";
+    }
+
+    /** @return array{0: string, 1: string} global epoch and day tiers; secret-independent so rotation never resets them. */
+    private function outcomeAdmissionGlobalTiers(string $policyName): array
+    {
+        $scope = hash('sha256', "{$policyName}:{$this->envScope}");
+
+        return ["oaaa:v1:g:e:{$scope}", "oaaa:v1:g:d:{$scope}"];
+    }
+
+    private function outcomeAdmissionWindow(): int
+    {
+        return intdiv($this->clock->now()->getTimestamp(), self::OAAA_CREDIT_WINDOW_SECONDS);
+    }
+
+    /**
+     * @param list<array{rule: string, key: string, previousKey: ?string, fired: bool, advisory: bool}> $scopes
+     * @return list<array{key: string, previousKey: ?string, cap: int, ttl: int, creditKeys: list<string>}>
+     */
+    private function outcomeAdmissionTiers(array $scopes, string $policyName): array
+    {
+        $window = $this->outcomeAdmissionWindow();
+        $tiers = [];
+        foreach ($scopes as $scope) {
+            $credits = [
+                $this->outcomeAdmissionCreditKey($scope['rule'], $scope['key'], $window),
+                $this->outcomeAdmissionCreditKey($scope['rule'], $scope['key'], $window - 1),
+            ];
+            if ($scope['previousKey'] !== null && $scope['previousKey'] !== $scope['key']) {
+                $credits[] = $this->outcomeAdmissionCreditKey($scope['rule'], $scope['previousKey'], $window);
+                $credits[] = $this->outcomeAdmissionCreditKey($scope['rule'], $scope['previousKey'], $window - 1);
+            }
+            $previous = $scope['previousKey'] !== null && $scope['previousKey'] !== $scope['key'] ? $scope['previousKey'] : null;
+            $tiers[] = [
+                'key' => $this->outcomeAdmissionEpochTier($scope['rule'], $scope['key']),
+                'previousKey' => $previous === null ? null : $this->outcomeAdmissionEpochTier($scope['rule'], $previous),
+                'cap' => self::OAAA_SCOPE_EPOCH_UNITS,
+                'ttl' => self::OAAA_SCOPE_EPOCH_SECONDS,
+                'creditKeys' => $credits,
+            ];
+            $tiers[] = [
+                'key' => $this->outcomeAdmissionDayTier($scope['rule'], $scope['key']),
+                'previousKey' => $previous === null ? null : $this->outcomeAdmissionDayTier($scope['rule'], $previous),
+                'cap' => self::OAAA_SCOPE_DAY_UNITS,
+                'ttl' => self::OAAA_DAY_SECONDS,
+                'creditKeys' => [],
+            ];
+        }
+        [$globalEpoch, $globalDay] = $this->outcomeAdmissionGlobalTiers($policyName);
+        $tiers[] = ['key' => $globalEpoch, 'previousKey' => null, 'cap' => self::OAAA_GLOBAL_EPOCH_UNITS, 'ttl' => self::OAAA_SCOPE_EPOCH_SECONDS, 'creditKeys' => []];
+        $tiers[] = ['key' => $globalDay, 'previousKey' => null, 'cap' => self::OAAA_GLOBAL_DAY_UNITS, 'ttl' => self::OAAA_DAY_SECONDS, 'creditKeys' => []];
+
+        return $tiers;
+    }
+
+    /**
+     * @param list<array{rule: string, key: string, previousKey: ?string, fired: bool, advisory: bool}> $scopes
+     * @return list<string> current-generation tiers only (refunds never touch a previous generation)
+     */
+    private function outcomeAdmissionTierKeys(array $scopes, string $policyName): array
+    {
+        $keys = [];
+        foreach ($scopes as $scope) {
+            $keys[] = $this->outcomeAdmissionEpochTier($scope['rule'], $scope['key']);
+            $keys[] = $this->outcomeAdmissionDayTier($scope['rule'], $scope['key']);
+        }
+        foreach ($this->outcomeAdmissionGlobalTiers($policyName) as $key) {
+            $keys[] = $key;
+        }
+
+        return array_values(array_unique($keys));
+    }
+
+    /**
+     * @param list<array{rule: string, key: string, previousKey: ?string, fired: bool, advisory: bool}> $scopes
+     * @return list<string>
+     */
+    private function outcomeAdmissionCreditKeys(array $scopes): array
+    {
+        $window = $this->outcomeAdmissionWindow();
+        $keys = [];
+        foreach ($scopes as $scope) {
+            $keys[] = $this->outcomeAdmissionCreditKey($scope['rule'], $scope['key'], $window);
+        }
+
+        return array_values(array_unique($keys));
+    }
