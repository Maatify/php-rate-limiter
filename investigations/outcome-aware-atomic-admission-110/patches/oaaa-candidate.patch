@@ -1723,0 +1725,182 @@ LUA;
+    // ---- EXPERIMENTAL #110 OAAA (study only) -------------------------------------------------------------------------
+
+    private const OAAA_RESERVE = <<<'LUA'
+local tupleKey = KEYS[1]
+local n = tonumber(ARGV[2])
+local ki, ai = 2, 3
+local tiers = {}
+for i = 1, n do
+  local t = {key = KEYS[ki], cap = tonumber(ARGV[ai]), ttl = tonumber(ARGV[ai + 1]), hasPrev = tonumber(ARGV[ai + 2]), nCredit = tonumber(ARGV[ai + 3]), credits = {}}
+  ki = ki + 1
+  ai = ai + 4
+  if t.hasPrev == 1 then t.prev = KEYS[ki]; ki = ki + 1 end
+  for c = 1, t.nCredit do t.credits[c] = KEYS[ki]; ki = ki + 1 end
+  tiers[i] = t
+end
+local function units(key)
+  if redis.call('EXISTS', key) == 0 then return 0 end
+  if redis.call('TTL', key) < 0 then return nil end
+  local u = tonumber(redis.call('HGET', key, 'u'))
+  if not u or u < 0 or u ~= math.floor(u) or not redis.call('HGET', key, 'e') then return nil end
+  return u
+end
+for i = 1, n do
+  local t = tiers[i]
+  local used = units(t.key)
+  if used == nil then return redis.error_reply('malformed admission tier') end
+  if t.prev then
+    local previous = units(t.prev)
+    if previous == nil then return redis.error_reply('malformed previous admission tier') end
+    used = used + previous
+  end
+  local effective = t.cap
+  if t.nCredit > 0 then
+    local seen, count = {}, 0
+    for c = 1, t.nCredit do
+      if redis.call('EXISTS', t.credits[c]) == 1 then
+        if redis.call('TTL', t.credits[c]) < 0 then return redis.error_reply('malformed admission credit') end
+        for _, m in ipairs(redis.call('SMEMBERS', t.credits[c])) do
+          if not seen[m] then seen[m] = true; count = count + 1 end
+        end
+      end
+    end
+    if count < effective then effective = count end
+  end
+  if used >= effective then return 0 end
+end
+local tupleExisted = redis.call('EXISTS', tupleKey)
+if tupleExisted == 1 and redis.call('TTL', tupleKey) < 0 then return redis.error_reply('malformed admission tuple') end
+local now = redis.call('TIME')
+local epochId = now[1] .. '.' .. now[2]
+for i = 1, n do
+  local t = tiers[i]
+  if redis.call('EXISTS', t.key) == 0 then
+    redis.call('HSET', t.key, 'e', epochId, 'u', 0)
+    redis.call('EXPIRE', t.key, t.ttl)
+  end
+  redis.call('HINCRBY', t.key, 'u', 1)
+  local e = redis.call('HGET', t.key, 'e')
+  if redis.call('HGET', tupleKey, 'e|' .. t.key) ~= e then
+    redis.call('HSET', tupleKey, 'e|' .. t.key, e, 'p|' .. t.key, 0, 'f|' .. t.key, 0)
+  end
+  redis.call('HINCRBY', tupleKey, 'p|' .. t.key, 1)
+end
+if tupleExisted == 0 then redis.call('EXPIRE', tupleKey, ARGV[1]) end
+return 1
+LUA;
+
+    private const OAAA_COMPLETE = <<<'LUA'
+local tupleKey = KEYS[1]
+local outcome = ARGV[1]
+local n = tonumber(ARGV[2])
+local refundMax = tonumber(ARGV[3])
+local m = tonumber(ARGV[4])
+local plan = {}
+local paired = {}
+if redis.call('EXISTS', tupleKey) == 1 then
+  if redis.call('TTL', tupleKey) < 0 then return redis.error_reply('malformed admission tuple') end
+  for i = 1, n do
+    local k = KEYS[1 + i]
+    local p = tonumber(redis.call('HGET', tupleKey, 'p|' .. k) or '0')
+    local f = tonumber(redis.call('HGET', tupleKey, 'f|' .. k) or '0')
+    if not p or not f or p < 0 or f < 0 then return redis.error_reply('malformed admission tuple') end
+    if p > 0 or f > 0 then
+      local e = redis.call('HGET', tupleKey, 'e|' .. k)
+      local live = e ~= false and redis.call('EXISTS', k) == 1 and redis.call('HGET', k, 'e') == e
+      local refund = 0
+      if p > 0 then paired[#paired + 1] = i end
+      if outcome == 'success' then
+        if p > 0 then p = p - 1; refund = 1 end
+        local rf = math.min(f, refundMax)
+        refund = refund + rf
+        f = f - rf
+      elseif outcome == 'failure' then
+        if p > 0 then p = p - 1; f = f + 1 end
+      else
+        if p > 0 then p = p - 1; refund = 1 end
+      end
+      if not live then p, f, refund = 0, 0, 0 end
+      if refund > 0 then
+        local u = tonumber(redis.call('HGET', k, 'u'))
+        if not u or u < refund then return redis.error_reply('malformed admission tier') end
+      end
+      plan[#plan + 1] = {k = k, p = p, f = f, refund = refund}
+    end
+  end
+end
+for _, s in ipairs(plan) do
+  if s.refund > 0 then redis.call('HINCRBY', s.k, 'u', -s.refund) end
+  redis.call('HSET', tupleKey, 'p|' .. s.k, s.p, 'f|' .. s.k, s.f)
+end
+if outcome == 'success' then
+  for c = 1, m do
+    local ck = KEYS[1 + n + c]
+    local existed = redis.call('EXISTS', ck)
+    if redis.call('SISMEMBER', ck, ARGV[5]) == 0 and redis.call('SCARD', ck) < tonumber(ARGV[6]) then
+      redis.call('SADD', ck, ARGV[5])
+      if existed == 0 then redis.call('EXPIRE', ck, ARGV[7]) end
+    end
+  end
+end
+return paired
+LUA;
+
+    public function reserveAdmission(string $tupleKey, int $tupleTtlSeconds, array $tiers): bool
+    {
+        $this->positive($tupleTtlSeconds, 'Admission tuple TTL');
+        $keys = [$this->key('oaaa', $tupleKey)];
+        $args = [$tupleTtlSeconds, count($tiers)];
+        foreach ($tiers as $tier) {
+            $this->positive($tier['ttl'], 'Admission tier TTL');
+            if ($tier['cap'] < 0) {
+                throw new RateLimiterException('Admission tier capacity must not be negative.');
+            }
+            $keys[] = $this->key('oaaa', $tier['key']);
+            if ($tier['previousKey'] !== null) {
+                $keys[] = $this->key('oaaa', $tier['previousKey']);
+            }
+            foreach ($tier['creditKeys'] as $creditKey) {
+                $keys[] = $this->key('oaaa', $creditKey);
+            }
+            array_push($args, $tier['cap'], $tier['ttl'], $tier['previousKey'] === null ? 0 : 1, count($tier['creditKeys']));
+        }
+        $granted = $this->integerValue($this->eval(self::OAAA_RESERVE, $keys, $args), 'admission reservation');
+        if ($granted !== 0 && $granted !== 1) {
+            throw new RateLimiterException('Malformed admission reservation response.');
+        }
+
+        return $granted === 1;
+    }
+
+    public function completeAdmission(string $tupleKey, string $outcome, array $tierKeys, int $refundFailures, array $creditKeys, string $creditMember, int $creditCap, int $creditTtlSeconds): array
+    {
+        if (! in_array($outcome, ['success', 'failure', 'cancel'], true) || $refundFailures < 0) {
+            throw new RateLimiterException('Invalid admission completion.');
+        }
+        $this->positive($creditCap, 'Admission credit capacity');
+        $this->positive($creditTtlSeconds, 'Admission credit TTL');
+        $keys = [$this->key('oaaa', $tupleKey)];
+        foreach ($tierKeys as $tierKey) {
+            $keys[] = $this->key('oaaa', $tierKey);
+        }
+        foreach ($creditKeys as $creditKey) {
+            $keys[] = $this->key('oaaa', $creditKey);
+        }
+        $result = $this->eval(self::OAAA_COMPLETE, $keys, [$outcome, count($tierKeys), $refundFailures, count($creditKeys), $creditMember, $creditCap, $creditTtlSeconds]);
+        if (! is_array($result)) {
+            throw new RateLimiterException('Malformed admission completion response.');
+        }
+        $paired = [];
+        foreach ($result as $index) {
+            $i = $this->integerValue($index, 'admission completion index');
+            if ($i < 1 || $i > count($tierKeys)) {
+                throw new RateLimiterException('Malformed admission completion response.');
+            }
+            $paired[] = $tierKeys[$i - 1];
+        }
+
+        return $paired;
+    }
+
+    // ---- end EXPERIMENTAL #110 OAAA -----------------------------------------------------------------------------------
+
