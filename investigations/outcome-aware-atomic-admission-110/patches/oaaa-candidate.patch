+<?php
+
+declare(strict_types=1);
+
+namespace Maatify\RateLimiter\Repository;
+
+/**
+ * EXPERIMENTAL (#110 OAAA study only; not a package contract): atomic,
+ * outcome-linked admission reservations for correlation headroom.
+ *
+ * A tier is a fixed-TTL counter of admission units ("u") stamped with an epoch
+ * identifier ("e") that is set when the tier is created and never refreshed.
+ * A tuple record remembers, per tier, how many of its reservations are still
+ * unresolved ("p"), how many were resolved as failures ("f") and the tier epoch
+ * they were taken in. Every method is one atomic operation over all keys it
+ * names; a partial reservation is never visible.
+ */
+interface OutcomeAdmissionStoreInterface
+{
+    /**
+     * Reserve one unit on every tier, or on none.
+     *
+     * A tier admits when its current units plus the units of its read-only
+     * previous generation are below its effective capacity. The effective
+     * capacity is the tier cap, or, when credit keys are given, the smaller of
+     * the cap and the number of distinct members in the union of those credit
+     * sets. Absent tiers are created with their TTL; the tuple record is created
+     * with its TTL on first use and never refreshed.
+     *
+     * @param list<array{key: string, previousKey: ?string, cap: int, ttl: int, creditKeys: list<string>}> $tiers
+     * @return bool True when every tier admitted and one unit was taken on each.
+     * @throws \Throwable When state is malformed or atomicity cannot be provided.
+     */
+    public function reserveAdmission(string $tupleKey, int $tupleTtlSeconds, array $tiers): bool;
+
+    /**
+     * Resolve one reservation of the tuple with a Host outcome.
+     *
+     * outcome "failure": one unresolved reservation per tier becomes a recorded
+     * failure (its unit stays spent). outcome "success": one unresolved
+     * reservation per tier is released, plus at most $refundFailures recorded
+     * failures of the same tuple, and the credit member is added to every
+     * credit set (bounded by $creditCap, TTL set on creation). outcome "cancel":
+     * one unresolved reservation per tier is released, nothing else changes.
+     * Units are returned only to the tier epoch they were taken from and only
+     * for tiers listed in $tierKeys; anything else stays spent.
+     *
+     * @param string $outcome One of "success", "failure" or "cancel"; anything else is rejected.
+     * @param list<string> $tierKeys
+     * @param list<string> $creditKeys
+     * @return list<string> Tier keys on which an unresolved reservation of the tuple was resolved.
+     * @throws \Throwable When state is malformed or atomicity cannot be provided.
+     */
+    public function completeAdmission(
+        string $tupleKey,
+        string $outcome,
+        array $tierKeys,
+        int $refundFailures,
+        array $creditKeys,
+        string $creditMember,
+        int $creditCap,
+        int $creditTtlSeconds,
+    ): array;
+}
