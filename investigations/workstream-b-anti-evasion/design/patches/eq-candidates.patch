+    private bool $eqScored = false;
+
+    // ------------------------------------------------------------------------------------------------------------------
+    // EQ-EXPERIMENT — Evidence-Qualified Correlation Enforcement (design proof; NOT production code, never part of src/).
+    // WSB_CANDIDATE selects the variant: EQN = detection+enforcement only on policy-scored commands (rejected ablation); EQW = S0
+    // detection on every command, enforcement only with fresh scored evidence (a fixed 60 s WATCH marker) in the detection scope;
+    // EQL = EQW, except that LOW (UA-only) cross-IP dilution is advisory (no state, no enforcement); EQV = EQL, except that for access-scored
+    // policies a call is evidence only at the near-threshold volume score (L1 - 1) of K2/K3. EQ_MUTATE (test-only fault injectors):
+    // ungated | no_marker | no_previous | long_marker | low_enforce (= EQW's LOW rule) | low_narrow (LOW enforced on the scored request only).  Existing store capabilities only (incrementWatchFlag / getWatchFlag); no read-then-increment.
+    // ------------------------------------------------------------------------------------------------------------------
+    private function eqMode(): string
+    {
+        $c = getenv('WSB_CANDIDATE');
+
+        return $c === false || $c === '' ? 'S0' : $c;
+    }
+
+    private function eqMutation(string $name): bool
+    {
+        $m = getenv('EQ_MUTATE');
+
+        return $m !== false && in_array($name, explode(',', $m), true);
+    }
+
+    /**
+     * @param array<string, int> $decayedScores
+     */
+    private function eqScoredCommand(BlockPolicyInterface $policy, RateLimitCommand $request, array $decayedScores): bool
+    {
+        if ($request->isPreCheck) {
+            return false;
+        }
+        if ($request->isFailure) {
+            return true;
+        }
+        $access = $policy->getScoreDeltas()->access;
+        if ($access <= 0) {
+            return false;
+        }
+        if ($this->eqMode() !== 'EQV') {
+            return true;
+        }
+
+        // EQV: an access-scored policy has no failures; its own evidence of overuse is the volume score. A call is evidence only when the
+        // K2 or K3 score after this call reaches the near-threshold level (L1 - 1) that DECISION_MATRIX section 5.0 already uses for WATCH.
+        foreach (['k2', 'k3'] as $type) {
+            $thresholds = $this->getScopedThresholds($type, $policy);
+            if ($thresholds !== null && $thresholds->l1 !== PHP_INT_MAX
+                && ($decayedScores[$type] ?? 0) + $access * $request->cost >= $thresholds->l1 - 1) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function eqMarkerKey(string $policyName, string $kind, string $scope, string $secret): string
+    {
+        return $this->hashKey("{$policyName}:rate_limiter:eq:fresh:{$kind}:v1:{$this->envScope}:{$scope}", $secret);
+    }
+
+    /** Fresh scored evidence marker (fixed 60 s, atomic increment; the previous generation is read-only). */
+    private function eqMark(string $policyName, string $kind, string $scope): void
+    {
+        if (! in_array($this->eqMode(), ['EQW', 'EQL', 'EQV'], true) || ! $this->eqScored || $this->eqMutation('no_marker')) {
+            return;
+        }
+        $this->correlationStore->incrementWatchFlag(
+            $this->eqMarkerKey($policyName, $kind, $scope, $this->secret),
+            $this->eqMutation('long_marker') ? 600 : 60,
+        );
+    }
+
+    private function eqQualified(string $policyName, string $kind, string $scope, ?string $previousScope): bool
+    {
+        if (! in_array($this->eqMode(), ['EQW', 'EQL', 'EQV'], true) || $this->eqMutation('ungated')) {
+            return true;
+        }
+        if ($this->correlationStore->getWatchFlag($this->eqMarkerKey($policyName, $kind, $scope, $this->secret)) > 0) {
+            return true;
+        }
+
+        return $previousScope !== null
+            && ! $this->eqMutation('no_previous')
+            && $this->correlationStore->getWatchFlag(
+                $this->eqMarkerKey($policyName, $kind, $previousScope, $this->previousSecret ?? $this->secret),
+            ) > 0;
+    }
+
