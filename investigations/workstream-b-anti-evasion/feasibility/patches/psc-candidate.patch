+    private function pscActive(): bool
+    {
+        return in_array($this->pscMode(), ['PSC', 'PSCA'], true);
+    }
+
+    private function pscMutation(string $name): bool
+    {
+        $m = getenv('PSC_MUTATE');
+
+        return $m !== false && in_array($name, explode(',', $m), true);
+    }
+
+    private function pscScoredCommand(BlockPolicyInterface $policy, RateLimitCommand $request): bool
+    {
+        return ! $request->isPreCheck && ($request->isFailure || $policy->getScoreDeltas()->access > 0);
+    }
+
+    private function pscWindowObservation(string $kind, BoundedCorrelationObservationDTO $o): BoundedCorrelationObservationDTO
+    {
+        $domain = "psc:window:v1:{$this->envScope}:{$kind}";
+        $previousSecret = $this->previousSecret ?? $this->secret;
+
+        return new BoundedCorrelationObservationDTO(
+            $this->hashKey("{$domain}:scope:{$o->currentKey}", $this->secret),
+            $o->currentMember,
+            $o->previousKey === null ? null : $this->hashKey("{$domain}:scope:{$o->previousKey}", $previousSecret),
+            $o->previousMember,
+            $o->bridgeKey === null ? null : $this->hashKey("{$domain}:bridge:{$o->currentKey}", $this->secret),
+        );
+    }
+
+    private function pscMarkerKey(string $kind, string $scope, string $secret): string
+    {
+        return $this->hashKey("psc:qualified:v1:{$this->envScope}:{$kind}:{$scope}", $secret);
+    }
+
+    /** Test-only sensitivity knob (PSC_CAP_CHURN / PSC_CAP_DILUTION): the corroboration window cap; unset = the S0 threshold (3 / 6). */
+    private function pscCap(string $kind, int $default): int
+    {
+        $v = getenv($kind === 'dilution' ? 'PSC_CAP_DILUTION' : 'PSC_CAP_CHURN');
+
+        return $v === false || $v === '' ? $default : max($default, min(50, (int) $v));
+    }
+
+    private function pscGate(string $kind, BoundedCorrelationObservationDTO $observation, int $cap, bool $triggered): bool
+    {
+        if (! $this->pscActive() || $this->pscMutation('ungated')) {
+            return $triggered;
+        }
+        $ttl = $this->pscMutation('long_window') ? 600 : 60;
+        $cap = $this->pscCap($kind, $cap);
+        if ($this->pscScored
+            && $this->addBoundedCorrelation($this->pscWindowObservation($kind, $observation), $ttl, $cap) >= $cap) {
+            $this->correlationStore->incrementWatchFlag($this->pscMarkerKey($kind, $observation->currentKey, $this->secret), $ttl);
+        }
+        if (! $triggered) {
+            return false;
+        }
+        if ($this->correlationStore->getWatchFlag($this->pscMarkerKey($kind, $observation->currentKey, $this->secret)) > 0) {
+            return true;
+        }
+
+        return $observation->previousKey !== null
+            && $this->correlationStore->getWatchFlag(
+                $this->pscMarkerKey($kind, $observation->previousKey, $this->previousSecret ?? $this->secret),
+            ) > 0;
+    }
