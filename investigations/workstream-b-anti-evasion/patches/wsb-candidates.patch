+    /** @param array<string, string|null> $keysV2 */
+    private function wsbGate(?array $candidate, string $kind, DeviceIdentityDTO $device, string $policyName, array $keysV2, bool $isEphemeral): ?array
+    {
+        $cand = $this->wsbCandidate();
+        if ($candidate === null || $cand === 'S0') {
+            return $candidate;
+        }
+        if ($this->wsbMutation('no_enforce')) {
+            // Storage-cap probes only: suppress enforcement so that every failed request still reaches the witness write.
+            return null;
+        }
+        $low = $device->confidence === 'LOW';
+        if ($cand === 'RL') {
+            $enforcementKey = $kind === 'dilutionK3' ? ($keysV2['k3'] ?? '') : ($keysV2['k2'] ?? '');
+            $sets = $this->wsbRlSets[$kind === 'churn' ? 'churn' : 'dilution'] ?? [];
+            $win = intdiv($this->clock->now()->getTimestamp(), 60);
+            $latchWin = null;
+            for ($w = $win; $w >= $win - 10; $w--) {
+                if ($this->correlationStore->getWatchFlag($this->wsbKey($policyName, 'latch', $enforcementKey, (string) $w)) > 0) {
+                    $latchWin = $w;
+                    break;
+                }
+            }
+            if ($latchWin !== null && ! $this->wsbMutation('no_fresh')) {
+                $fresh = false;
+                foreach ($sets as $setKey) {
+                    for ($w = $latchWin + 1; $w <= $win && ! $fresh; $w++) {
+                        $fresh = $this->correlationStore->getWatchFlag($this->wsbKey($policyName, 'rl-fresh', $setKey, (string) $w)) > 0;
+                    }
+                }
+                if (! $fresh) {
+                    return null;
+                }
+            }
+            $this->correlationStore->incrementWatchFlag($this->wsbKey($policyName, 'latch', $enforcementKey, (string) $win), 700);
+
+            return $candidate;
+        }
+        if ($cand === 'A1') {
+            return $low ? null : $candidate;
+        }
+        if (! in_array($cand, ['PW', 'P2'], true)) {
+            throw new RateLimiterException('Unknown WSB candidate: ' . $cand);
+        }
+        if ($kind === 'dilutionLow') {
+            // K2 enforcement from a LOW-confidence dilution has no failure witness by construction (no fingerprint members).
+            if ($cand === 'P2' && $this->wsbP2Soft($policyName, $device->normalizedUa)) {
+                $candidate['persistence'] = [];
+
+                return $candidate;
+            }
+
+            return null;
+        }
+        if ($kind === 'churn') {
+            $scope = 'k2:' . ($keysV2['k2'] ?? '');
+            $enforcementKey = $keysV2['k2'] ?? '';
+        } else {
+            $scope = 'fp:' . ($device->fingerprintHash ?? '');
+            $enforcementKey = $keysV2['k3'] ?? '';
+        }
+        if ($this->correlationStore->getWatchFlag($this->wsbKey($policyName, 'wit', $scope)) < 3) {
+            return null;
+        }
+        $win = intdiv($this->clock->now()->getTimestamp(), 60);
+        $latchWin = null;
+        for ($w = $win; $w >= $win - 10; $w--) {
+            if ($this->correlationStore->getWatchFlag($this->wsbKey($policyName, 'latch', $enforcementKey, (string) $w)) > 0) {
+                $latchWin = $w;
+                break;
+            }
+        }
+        if ($latchWin !== null && ! $this->wsbMutation('no_fresh')) {
+            $fresh = false;
+            for ($w = $latchWin + 1; $w <= $win; $w++) {
+                if ($this->correlationStore->getWatchFlag($this->wsbKey($policyName, 'fresh', $scope, (string) $w)) > 0) {
+                    $fresh = true;
+                    break;
+                }
+            }
+            if (! $fresh) {
+                return null;
+            }
+        }
+        $this->correlationStore->incrementWatchFlag($this->wsbKey($policyName, 'latch', $enforcementKey, (string) $win), 700);
+
+        return $candidate;
+    }
+
+    private function wsbP2Soft(string $policyName, string $ua): bool
+    {
+        $win = intdiv($this->clock->now()->getTimestamp(), 60);
+        $f = 0;
+        $s = 0;
+        $k = 0;
+        for ($w = $win - 9; $w <= $win; $w++) {
+            $f += $this->correlationStore->getWatchFlag($this->wsbKey($policyName, 'rf', $ua, (string) $w));
+            $s += $this->correlationStore->getWatchFlag($this->wsbKey($policyName, 'rs', $ua, (string) $w));
+            $k += $this->correlationStore->getWatchFlag($this->wsbKey($policyName, 'rk', $ua, (string) $w));
+        }
+
+        return $k >= 6 && ($f + $s) > 0 && $f / ($f + $s) >= 0.5;
+    }
