+    private function wsbTally(BoundedCorrelationStoreInterface $store, string $setKey, string $tallyKey, string $member): void
+    {
+        // Used by the ratio denominator: per-window distinct failing K1 count, derived from the tally flag (set cap 6).
+        $count = $this->correlationStore->getWatchFlag($tallyKey);
+        $r = $store->addDistinctBounded($setKey, $this->hashKey($member, $this->secret), 660, 6);
+        if ($r->accepted && $r->count > $count) {
+            $this->correlationStore->incrementWatchFlag($tallyKey, 660);
+        }
+    }
