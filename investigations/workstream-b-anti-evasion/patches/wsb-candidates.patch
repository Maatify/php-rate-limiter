+    // ------------------------------------------------------------------------------------------------------------------
+    // WSB-EXPERIMENT — Workstream B anti-evasion candidates A1 / PW / P2 / RL (investigation patch; NOT production code).
+    // Selected by env WSB_CANDIDATE (S0 = unmodified behaviour). WSB_MUTATE is a test-only fault injector used to prove that
+    // the investigation assertions can fail (uncap | no_fresh) or to isolate storage probes (no_enforce). State uses ONLY existing store capabilities
+    // (BoundedCorrelationStoreInterface / WATCH flags). NOT rotation-bridged, NOT IPv6-macro aware (documented limitation).
+    // ------------------------------------------------------------------------------------------------------------------
+    private function wsbCandidate(): string
+    {
+        $c = getenv('WSB_CANDIDATE');
+
+        return $c === false || $c === '' ? 'S0' : $c;
+    }
+
+    /** WSB_MUTATE is a comma list of test-only fault injectors (uncap | no_fresh | no_enforce). */
+    /**
+     * RL (recovery latch) observation: after every S0 bounded-set write, note whether THIS request brought a NEW distinct member
+     * (count above the per-set tally, or a member rejected at the cap). Fresh arrivals are recorded per 60 s window. Outcome
+     * independent: no failure evidence, no LOW exemption.
+     */
+    private function wsbRlObserve(string $kind, string $setKey, int $count, ?string $policyName = null): void
+    {
+        if ($this->wsbCandidate() !== 'RL') {
+            return;
+        }
+        $policy = $policyName ?? $this->wsbPolicyName;
+        $tally = $this->wsbKey($policy, 'rl-tally', $setKey);
+        $prev = $this->correlationStore->getWatchFlag($tally);
+        if ($count > $prev) {
+            $this->correlationStore->incrementWatchFlag($tally, 600);
+        }
+        if ($count > $prev || ! $this->wsbLastAccepted) {
+            $win = intdiv($this->clock->now()->getTimestamp(), 60);
+            $this->correlationStore->incrementWatchFlag($this->wsbKey($policy, 'rl-fresh', $setKey, (string) $win), 660);
+        }
+        $this->wsbRlSets[$kind][] = $setKey;
+    }
+
+    private function wsbMutation(string $name): bool
+    {
+        $m = getenv('WSB_MUTATE');
+
+        return $m !== false && in_array($name, explode(',', $m), true);
+    }
+
+    private function wsbKey(string $policyName, string $purpose, string $anchor, string $extra = ''): string
+    {
+        return $this->hashKey("{$policyName}:rate_limiter:wsb:{$purpose}:v1:{$this->envScope}:{$anchor}:{$extra}", $this->secret);
+    }
+
+    private function wsbBounded(): BoundedCorrelationStoreInterface
+    {
+        if (! $this->correlationStore instanceof BoundedCorrelationStoreInterface) {
+            throw new RateLimiterException('WSB candidate requires the BoundedCorrelationStoreInterface capability.');
+        }
+
+        return $this->correlationStore;
+    }
