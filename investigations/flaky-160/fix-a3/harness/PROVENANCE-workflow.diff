+        with:
+          php-version: '8.5'
+          coverage: none
+          extensions: redis
+      - run: composer update --no-interaction --prefer-dist --no-progress
+      - run: git worktree add --detach "$RUNNER_TEMP/main" 5202bf3
+      - run: composer update --working-dir "$RUNNER_TEMP/main" --no-interaction --prefer-dist --no-progress
+      - run: H_ROOT="$RUNNER_TEMP/main" bash investigations/flaky-160/harness/env.sh "$RUNNER_TEMP/f160d" decision
+      - run: bash investigations/flaky-160/fix-a3/harness/run.sh decision "$RUNNER_TEMP/f160d/decision" main "$RUNNER_TEMP/main" 5202bf3
+      - run: bash investigations/flaky-160/fix-a3/harness/run.sh decision "$RUNNER_TEMP/f160d/decision" head "$GITHUB_WORKSPACE" a45066a
+      - run: bash investigations/flaky-160/fix-a3/harness/run.sh decide "$RUNNER_TEMP/f160d/decision"
+      - if: always()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
