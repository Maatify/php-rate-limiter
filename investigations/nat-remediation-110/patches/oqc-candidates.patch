+    private function oqcLiveKey(string $scopeKey, int $window): string
+    {
+        return hash('sha256', 'oqc:live:v1:' . $scopeKey . ':' . $window);
+    }
+
+    /** Outcome-live = an outcome command was processed for the scope (Current or Previous key) in this or the previous 600 s window. */
+    private function oqcLiveRead(string $current, ?string $previous): bool
+    {
+        foreach ([$this->oqcWindow(), $this->oqcWindow(-1)] as $w) {
+            if ($this->correlationStore->getWatchFlag($this->oqcLiveKey($current, $w)) > 0) {
+                return true;
+            }
+            if ($previous !== null && $previous !== $current && $this->correlationStore->getWatchFlag($this->oqcLiveKey($previous, $w)) > 0) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function oqcLiveWrite(string $current): void
+    {
+        $this->correlationStore->incrementWatchFlag($this->oqcLiveKey($current, $this->oqcWindow()), 1200);
+    }
+
+    /**
+     * IPv6 macro scopes carry their own liveness (one hierarchy scope aggregates many base scopes, each of which starts silent).
+     *
+     * @param array{cidr: int, currentScope: string, previousScope: ?string} $scope
+     */
+    private function oqcMacroCommand(array $scope): bool
+    {
+        if (! $this->oqcActive || ! $this->oqcLiveRead($scope['currentScope'], $scope['previousScope'])) {
+            return true; // S0 / ineligible / silent macro scope
+        }
+
+        return $this->oqcRequest !== null && $this->oqcRequest->isFailure;
+    }
+
+    /** @param list<array{cidr: int, currentScope: string, previousScope: ?string}> $scopes */
+    private function oqcMarkMacro(array $scopes, RateLimitCommand $request): void
+    {
+        if (! $this->oqcActive || ! ($request->isFailure || $request->isSuccess)) {
+            return;
+        }
+        foreach ($scopes as $scope) {
+            $this->oqcLiveWrite($scope['currentScope']);
+        }
+    }
+
+    /** K2 churn (base + macro) may be observed and evaluated by the current command. */
+    private function oqcChurnCommand(): bool
+    {
+        if ($this->oqcChurnLive === null || ! $this->oqcChurnLive) {
+            return true; // S0 / ineligible / silent scope
+        }
+
+        return $this->oqcRequest !== null && $this->oqcRequest->isFailure;
+    }
+
+    /** K1 spray (base + macro) may be observed and evaluated by $request. */
+    private function oqcSprayCommand(RateLimitCommand $request): bool
+    {
+        if ($this->oqcSprayLive === null || ! $this->oqcSprayLive) {
+            return $request->isPreCheck; // S0 rule: pre-check only
+        }
+
+        return $request->isFailure;
+    }
+
+    /**
+     * Correlation block level/duration for a scope: S0 values unless arm OQCE AND the scope is outcome-live (silent scopes and
+     * checkOnly-only Hosts keep S0 exactly), where every re-issue within 1800 s escalates (1st L2/60 s, 2nd L3/300 s,
+     * 3rd+ L4/1800 s). Counter keyed on the Current scope key only (documented limitation).
+     *
+     * @return array{level: int, duration: int}
+     */
+    private function oqcIssue(string $kind, string $scopeKey): array
+    {
+        $live = $kind === 'churn' ? $this->oqcChurnLive : $this->oqcSprayLive;
+        if ($this->oqcArm() !== 'OQCE' || $live !== true) {
+            return ['level' => 2, 'duration' => 60];
+        }
+        $n = $this->correlationStore->incrementWatchFlag(hash('sha256', 'oqc:reissue:v1:' . $scopeKey), 1800);
+        $level = min(4, 1 + $n);
+
+        return ['level' => $level, 'duration' => PenaltyLadder::getDuration($level)];
+    }
+
+    /**
+     * Arm OQCW: true only when this observation raised the K1 distinct count (a new member arrived). The tally is created by
+     * the same observation that creates the set, so both expire together (fixed 600 s). Other arms: always true.
+     */
+    private function oqcNewMember(string $scopeKey, int $count): bool
+    {
+        if ($this->oqcArm() !== 'OQCW') {
+            return true;
+        }
+        $key = hash('sha256', 'oqc:tally:v1:' . $scopeKey);
+        $previous = $this->correlationStore->getWatchFlag($key);
+        if ($count <= $previous) {
+            return false;
+        }
+        for ($i = $previous; $i < $count; $i++) {
+            $this->correlationStore->incrementWatchFlag($key, 600);
+        }
+
+        return true;
+    }
