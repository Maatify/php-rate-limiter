+    // ------------------------------------------------------------------------------------------------------------------
+    // OQC-EXPERIMENT — #110 plan 1 "Outcome-Qualified Correlation" (investigation patch; NOT production code).
+    // Arms, selected by env OQC_ARM: S0 (unmodified behaviour) | OQC | OQCW (OQC + K1 WATCH on new member only) |
+    // OQCE (OQC + re-issue escalation L2 -> L3 -> L4 on the K1 / K2 correlation blocks).
+    // Rule (eligible policies = CREDENTIAL_SPRAY or DISTRIBUTED_ACCOUNT capability): K1 spray and K2 churn are observed AND
+    // evaluated only when (scope outcome-live AND command is recordFailure) OR (scope silent: S0 behaviour). A scope is
+    // outcome-live when ANY outcome command was processed for it in the current or the previous 600 s window (two window-id
+    // marker keys per scope, TTL 1200 s, exactly like S0's `dilution_confirmation` windows): liveness therefore lasts 600..1200 s
+    // after the last reported outcome and is renewed by outcomes. Markers are written AFTER the snapshot was taken (the outcome
+    // command that makes a silent scope live never observes under the live rule). The marker key is a plain sha-256 of the
+    // already-opaque scope key (not derived from the rotating secret); Current and Previous scope keys are both read, only
+    // Current is written. Scopes: K1 = IP, K2 = IP+UA, and every active IPv6 macro hierarchy scope (own markers).
+    // State uses ONLY the existing WATCH-flag capability of the correlation store (existence test; the count is irrelevant).
+    // ------------------------------------------------------------------------------------------------------------------
+    private ?bool $oqcChurnLive = null;
+    private ?bool $oqcSprayLive = null;
+    private ?RateLimitCommand $oqcRequest = null;
+    private bool $oqcActive = false;
+
+    private function oqcArm(): string
+    {
+        $a = getenv('OQC_ARM');
+
+        return $a === false || $a === '' ? 'S0' : $a;
+    }
+
+    /**
+     * @param array<string, string|null> $keysV2
+     * @param array<string, string|null> $keysV1
+     */
+    private function oqcPrepare(BlockPolicyInterface $policy, RateLimitCommand $request, DeviceIdentityDTO $device, array $keysV2, array $keysV1): void
+    {
+        $this->oqcChurnLive = null;
+        $this->oqcSprayLive = null;
+        $this->oqcRequest = $request;
+        $this->oqcActive = false;
+        if ($this->oqcArm() === 'S0' || ! ($this->isCredentialSprayPolicy($policy) || $this->isDistributedAccountPolicy($policy))) {
+            return;
+        }
+        $this->oqcActive = true;
+        $policyName = $policy->getName();
+        $scopes = [];
+        if ($device->fingerprintHash !== null && ($keysV2['k2'] ?? null) !== null) {
+            $churn = $this->buildCorrelationObservation(
+                $policyName,
+                'churn',
+                $keysV2['k2'],
+                $device->fingerprintHash,
+                $keysV1['k2'] ?? null,
+                $this->previousFingerprintHash($device),
+            );
+            $scopes['churn'] = [$churn->currentKey, $churn->previousKey];
+        }
+        if (($keysV2['k1'] ?? null) !== null) {
+            $previous = $this->previousSecret !== null && ($keysV1['k1'] ?? null) !== null ? 'credential_spray:' . $keysV1['k1'] : null;
+            $scopes['spray'] = ['credential_spray:' . $keysV2['k1'], $previous];
+        }
+        foreach ($scopes as $kind => [$current, $previous]) {
+            $live = $this->oqcLiveRead($current, $previous);
+            if ($kind === 'churn') {
+                $this->oqcChurnLive = $live;
+            } else {
+                $this->oqcSprayLive = $live;
+            }
+        }
+        if ($request->isFailure || $request->isSuccess) {
+            foreach ($scopes as [$current]) {
+                $this->oqcLiveWrite($current);
+            }
+        }
+    }
+
+    private function oqcWindow(int $offset = 0): int
+    {
+        return intdiv($this->clock->now()->getTimestamp(), 600) + $offset;
