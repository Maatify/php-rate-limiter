{
    "name": "maatify/php-rate-limiter",
    "description": "PHP library for deterministic, multi-signal rate-limit decisions.",
    "keywords": [
        "rate-limiter",
        "php",
        "maatify"
    ],
    "homepage": "https://github.com/Maatify/php-rate-limiter",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Maatify",
            "email": "support@maatify.dev",
            "homepage": "https://maatify.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/Maatify/php-rate-limiter/issues",
        "source": "https://github.com/Maatify/php-rate-limiter",
        "security": "https://github.com/Maatify/php-rate-limiter/blob/main/SECURITY.md"
    },
    "autoload": {
        "psr-4": {
            "Maatify\\RateLimiter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maatify\\RateLimiter\\Tests\\": "tests/"
        }
    },
    "require": {
        "ext-date": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-pcre": "*",
        "ext-random": "*",
        "maatify/exceptions": "^1.0",
        "maatify/shared-common": "^1.0",
        "php": "^8.4"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.95",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "analyse": "phpstan analyse src tests examples --level=max",
        "format": [
            "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
            "@php scripts/ci/check-per-cs-31-delta.php"
        ],
        "format:check": [
            "php-cs-fixer check --config=.php-cs-fixer.dist.php",
            "@php scripts/ci/check-per-cs-31-delta.php"
        ],
        "test": "bash scripts/ci/run-phpunit-with-redis.sh",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "bash scripts/ci/run-phpunit-with-redis.sh --testsuite Integration"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": false,
                "audit": "fail"
            }
        },
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
